# EasyEAP deployment settings. install.sh copies this to .env and fills in the hostname.
# Console and enrollment portal hostname (HTTPS). Users open https://<this>/ ; enrollment links use it too.
EASYEAP_HOSTNAME=easyeap.example.com
# Hostname embedded in certificates for CRL/OCSP (plain HTTP, port 80). Defaults to EASYEAP_HOSTNAME.
EASYEAP_PKI_HOSTNAME=
# IP address controllers use to reach RADIUS (shown in controller guides).
EASYEAP_RADIUS_ADDRESS=
# Bind addresses (restrict to an internal interface where possible).
EASYEAP_RADIUS_BIND=0.0.0.0
EASYEAP_HTTP_BIND=0.0.0.0
EASYEAP_HTTPS_BIND=0.0.0.0
# Published console ports (CRL/OCSP URLs in certificates assume port 80).
EASYEAP_HTTP_PORT=80
EASYEAP_HTTPS_PORT=443
# Lab mode enables insecure test-only options (keeping a Root CA online, plain LDAP). Never in production.
EASYEAP_LAB_MODE=false
EASYEAP_RADIUS_NODE=radius-1
EASYEAP_VERSION=1.0.0
