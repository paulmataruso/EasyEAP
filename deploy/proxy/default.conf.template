# Generated from default.conf.template (envsubst: EASYEAP_HOSTNAME).
limit_req_zone $binary_remote_addr zone=easyeap_login:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=easyeap_enroll:10m rate=30r/m;
limit_req_zone $binary_remote_addr zone=easyeap_api:10m rate=20r/s;
# Group Policy autoenrollment: generous, since a whole site's PCs can share one address behind NAT.
limit_req_zone $binary_remote_addr zone=easyeap_gpo:10m rate=30r/s;
server_tokens off;

upstream easyeap_api {
    server easyeap-api:8000;
    keepalive 16;
}

# Plain HTTP: CRL / OCSP / CA certificates (relying parties fetch these without TLS) and a redirect for everything else.
server {
    listen 8080 default_server;
    server_name _;

    location /pki/ {
        proxy_pass http://easyeap_api;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        client_max_body_size 16k;
        limit_except GET POST { deny all; }
    }
    location / {
        return 301 https://${EASYEAP_HOSTNAME}$request_uri;
    }
}

server {
    listen 8443 ssl default_server;
    http2 on;
    server_name ${EASYEAP_HOSTNAME};

    ssl_certificate     /etc/easyeap/tls/tls.crt;
    ssl_certificate_key /etc/easyeap/tls/tls.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_timeout 1d;
    ssl_session_cache shared:easyeap_tls:10m;
    ssl_session_tickets off;
    # Group Policy autoenrollment sends a Kerberos ticket in the Authorization header; a user in many groups makes it
    # large (Windows allows 48 KB, which is 64 KB in base64).
    large_client_header_buffers 4 64k;

    root /usr/share/nginx/html;
    include /etc/nginx/snippets/security-headers.conf;

    # The radius-agent channel is internal-only (it uses the private radius network directly).
    location /api/agent/ { return 404; }

    location = /api/auth/login {
        limit_req zone=easyeap_login burst=5 nodelay;
        proxy_pass http://easyeap_api;
        include /etc/nginx/snippets/proxy-params.conf;
    }
    location /api/enroll/ {
        limit_req zone=easyeap_enroll burst=10 nodelay;
        proxy_pass http://easyeap_api;
        include /etc/nginx/snippets/proxy-params.conf;
    }
    # Backup uploads stream straight through to the API (which checks authorisation before reading the body) instead of
    # being buffered here; backups can be many gigabytes.
    location ~ ^/api/(system|setup)/restore/upload$ {
        limit_req zone=easyeap_api burst=10 nodelay;
        client_max_body_size 64g;
        client_body_timeout 300s;
        proxy_request_buffering off;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header Referrer-Policy;
        proxy_hide_header X-Frame-Options;
        proxy_pass http://easyeap_api;
    }
    location ~ ^/api/system/backups/[0-9a-f]+/download$ {
        limit_req zone=easyeap_api burst=10 nodelay;
        proxy_buffering off;
        proxy_pass http://easyeap_api;
        include /etc/nginx/snippets/proxy-params.conf;
    }
    location /api/ {
        limit_req zone=easyeap_api burst=60 nodelay;
        proxy_pass http://easyeap_api;
        include /etc/nginx/snippets/proxy-params.conf;
    }
    location /pki/ {
        proxy_pass http://easyeap_api;
        include /etc/nginx/snippets/proxy-params.conf;
    }
    # Group Policy autoenrollment (MS-XCEP policy, MS-WSTEP enrollment): Windows PCs, authenticated by Kerberos in the
    # API. No per-address limit here: a whole office refreshes policy at once behind one NAT address; the API limits
    # each authenticated account instead. TLS must end here, at the certificate the API checks channel binding against.
    location ~ ^/(cep|ces)/[a-z0-9-]+$ {
        limit_except POST { deny all; }
        limit_req zone=easyeap_gpo burst=300 nodelay;
        client_max_body_size 64k;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 60s;
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header Referrer-Policy;
        proxy_hide_header X-Frame-Options;
        proxy_pass http://easyeap_api;
    }
    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri =404;
    }
    location = /enroll.html { add_header Cache-Control "no-store"; include /etc/nginx/snippets/security-headers.conf; }
    location / {
        add_header Cache-Control "no-store";
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri /index.html;
    }
}
